# Header rules for Cloudflare Workers static assets (parsed by Workers, never served).
# Ported from the old netlify.toml so the origin change does not drop the rules.
# Note: these apply to assets served by the assets layer. Responses generated by
# worker.js (the /api/* routes and /api/images) set their own headers.

# Self-hosted DM Sans woff2 files are content-stable — cache hard.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
