# Header rules for Cloudflare Workers static assets (parsed by Workers, never served).
# Ported from the old netlify.toml so the origin change does not drop the rules.
# Note: these apply to assets served by the assets layer. Responses generated by
# worker.js (the /api/* routes and /api/images) set their own headers.

# Self-hosted DM Sans woff2 files are content-stable — cache hard.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The admin SPA must never be framed: blocks clickjacking of the token prompt
# and of authenticated admin actions. Worker-generated /api/admin/* responses
# set the same headers themselves.
/admin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: no-referrer

/admin.html
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Referrer-Policy: no-referrer
