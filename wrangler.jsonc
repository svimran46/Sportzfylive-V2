{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "sportzfylive",

  "main": "worker.js",

  "compatibility_date": "2026-09-17",

  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "."
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  "queues": {
    "producers": [
      {
        "binding": "SPORTZFY_SYNC_QUEUE",
        "queue": "sportzfylive-sync"
      }
    ],
    "consumers": [
      {
        "queue": "sportzfylive-sync",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_concurrency": 1,
        "max_retries": 3
      }
    ]
  },

  "kv_namespaces": [
    {
      "binding": "SPORTZFY_DB",
      "id": "bd1be243a4494a369d16617100f09561"
    }
  ]
}
